APP_NAME=GitHub Orbit
APP_URL=http://localhost:3010
DEMO_MODE=true
PERSONAL_MODE=true
PORT=3000
WEB_PORT=3010

DATABASE_URL=postgresql://orbit:orbit@localhost:5432/orbit
REDIS_URL=redis://localhost:6379

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_VERSION=2026-03-10
GITHUB_OAUTH_CALLBACK=http://localhost:3010/auth/github/callback
# Recommended for hosted installs: set this before exposing Orbit publicly.
ADMIN_GITHUB_LOGINS=your-github-login

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/text-embedding-3-large
OPENROUTER_DIMENSIONS=1024

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=orbit_session

POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit
CADDY_DOMAIN=localhost

# Optional offsite backup target
BACKUP_S3_URL=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
